{
  "name": "OrionTV",
  "private": true,
  "main": "expo-router/entry",
  "version": "3.0.0",
  "scripts": {
    "start": "cross-env EXPO_TV=1 EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "cross-env EXPO_TV=1 EXPO_NO_METRO_WORKSPACE_ROOT=1 expo run:android",
    "ios": "cross-env EXPO_TV=1 EXPO_NO_METRO_WORKSPACE_ROOT=1 expo run:ios",
    "prebuild": "cross-env EXPO_TV=1 EXPO_NO_METRO_WORKSPACE_ROOT=1 expo prebuild --clean && yarn copy-config",
    "copy-config": "node scripts/copy-config.js",
    "build": "cross-env NODE_ENV=production EXPO_TV=1 yarn prebuild && cd android && ./gradlew assembleRelease",
    "build-debug": "cd android && ./gradlew assembleDebug",
    "test": "jest --watchAll",
    "test-ci": "jest --ci --coverage --no-cache",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "clean": "expo r -c && yarn cache clean && cd android && ./gradlew clean",
    "clean-modules": "rm -rf node_modules && yarn install",
    "reset-project": "./scripts/reset-project.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "resolutions": {
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "eslint": "^9.39.2",
    "babel-plugin-syntax-hermes-parser": "^0.36.1",
    "hermes-parser": "^0.36.1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.15",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-blob-util": "^0.22.2",
    "react-native-file-viewer": "^2.1.5",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-media-console": "^2.2.4",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.3",
    "react-native-tcp-socket": "^6.4.2",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.1",
    "react-native-worklets": "~0.10.4",
    "webpack": "^5.109.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@eslint/eslintrc": "^3.3.3",
    "@react-native/assets-registry": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~29.5.12",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}